# Copy to .env.

# The public hostname you attach to the tunnel in Zero Trust (a subdomain of a zone on Cloudflare).
DOMAIN=drop.example.com

# Tunnel token from Zero Trust, Networks, Tunnels (create a tunnel, choose Docker, copy the token).
TUNNEL_TOKEN=

# id:sha256:<hash> entries from: docker compose run --rm relay keygen -id agent1
AGENT_KEYS=

# RELAY_IMAGE=ghcr.io/burndrop/burndrop-relay:v0.1.0
