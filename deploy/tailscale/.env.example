# Copy to .env.

# https://<machine>.<tailnet>.ts.net (tailscale status shows the machine name;
# with the sidecar it is TS_HOSTNAME, default burndrop)
PUBLIC_ORIGIN=https://burndrop.tailnet-name.ts.net

# id:sha256:<hash> entries from: docker compose run --rm relay keygen -id agent1
AGENT_KEYS=

# Sidecar only: an auth key from the Tailscale admin console (tagged and reusable is best).
# TS_AUTHKEY=tskey-auth-...
# TS_HOSTNAME=burndrop

# RELAY_IMAGE=ghcr.io/burndrop/burndrop-relay:v0.1.0
